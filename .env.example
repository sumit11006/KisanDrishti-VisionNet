# ============================================
# Krishi-Vision BRICS-AgriN Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Google Cloud Platform ----
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
VERTEX_AI_LOCATION=us-central1

# ---- Vertex AI / Gemini ----
GEMINI_MODEL=gemini-1.5-pro-002
GEMINI_FLASH_MODEL=gemini-1.5-flash-002
VERTEX_AI_RAG_CORPUS_ID=your-rag-corpus-id

# ---- Google Earth Engine ----
GEE_SERVICE_ACCOUNT=your-gee-sa@your-project.iam.gserviceaccount.com
GEE_PROJECT_ID=your-gcp-project-id

# ---- ISRO Bhuvan / MOSDAC ----
BHUVAN_API_KEY=your-bhuvan-api-key
BHUVAN_BASE_URL=https://bhuvan-app1.nrsc.gov.in/api
MOSDAC_BASE_URL=https://mosdac.gov.in/api

# ---- IMD Weather ----
IMD_API_BASE_URL=https://api.imd.gov.in/v1
IMD_API_KEY=your-imd-api-key

# ---- AgriStack / UFSI ----
AGRISTACK_API_URL=https://agristack.gov.in/api/v1
AGRISTACK_API_KEY=your-agristack-api-key

# ---- BigQuery ----
BIGQUERY_DATASET=krishi_vision_analytics
BIGQUERY_LOCATION=US

# ---- BRICS AgriN Exchange ----
BRICS_EXCHANGE_ENABLED=true
BRICS_INDIA_ENDPOINT=https://agrin.icar.gov.in/api/v1
BRICS_BRAZIL_ENDPOINT=https://agrin.embrapa.br/api/v1
BRICS_SOUTH_AFRICA_ENDPOINT=https://agrin.arc.agric.za/api/v1
BRICS_CHINA_ENDPOINT=https://agrin.caas.cn/api/v1
BRICS_RUSSIA_ENDPOINT=https://agrin.ras.ru/api/v1
BRICS_ETHIOPIA_ENDPOINT=https://agrin.eiar.gov.et/api/v1
BRICS_EGYPT_ENDPOINT=https://agrin.ecad.eg/api/v1
BRICS_UAE_ENDPOINT=https://agrin.icba.org.ae/api/v1

# ---- Redis (Local Dev) ----
REDIS_URL=redis://localhost:6379/0

# ---- Application ----
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ---- Mobile App ----
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000
